# DataPilot AI Environment Configuration
# Default PostgreSQL URL (local installation or Docker)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/datapilot
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/datapilot_test

# Application
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Storage
ARTIFACTS_DIR=artifacts
DATA_DIR=data

# ML Settings
DEFAULT_OBSERVATION_DAYS=90
DEFAULT_PREDICTION_DAYS=60
RANDOM_SEED=42
